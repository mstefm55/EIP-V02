# Public single-origin entrypoint for staging users/operators
STAGING_PUBLIC_ORIGIN=https://localhost:8443
STAGING_PORT=8443
STAGING_HOST=127.0.0.1

# TLS gateway mode (recommended for secure local/staging shape)
STAGING_TLS_ENABLED=true
STAGING_TLS_AUTOGENERATE=true
STAGING_TLS_CERT_FILE=deploy/staging/certs/localhost.crt
STAGING_TLS_KEY_FILE=deploy/staging/certs/localhost.key

# Optional HTTP redirect listener (set empty to disable and avoid port conflicts)
STAGING_HTTP_REDIRECT_PORT=

# Upstream API origin (internal from the gateway process)
STAGING_API_ORIGIN=http://127.0.0.1:4000

# Built workbench assets served by the gateway
STAGING_UI_DIST=apps/workbench-ui/dist

# Staging smoke accounts (used by smoke scripts)
STAGING_SMOKE_TENANT_CODE=v2seed
STAGING_SMOKE_ADMIN_LOGIN=v2.workbench.admin
STAGING_SMOKE_LIMITED_LOGIN=v2.workbench.limited
STAGING_SMOKE_SHARED_PASSWORD=V2Smoke!Pass123
