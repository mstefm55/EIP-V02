# EIP Core V2 root deployment/env checklist
#
# Do not put real secrets in this file.
# API runtime variables are consumed by services/api.
# Workbench UI variables are consumed by apps/workbench-ui build/runtime.

# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=4010
LOG_LEVEL=info
TRUST_PROXY=true

# Browser/API origins
# Set to the deployed dashboard/workbench origin(s), comma-separated.
CORS_ORIGIN=https://your-workbench.example.com
CORS_CREDENTIALS=true

# Railway/Postgres
# Prefer Railway's injected DATABASE_URL when using a Railway Postgres service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_SSL=true
DATABASE_SSL_ALLOW_INVALID_CERTS=false
DATABASE_POOL_MAX=10

# Auth shell secrets
# Generate strong random values; never reuse V1 secrets.
AUTH_SESSION_PEPPER=replace_with_strong_random_hex
AUTH_CSRF_PEPPER=replace_with_strong_random_hex
AUTH_DEVICE_PEPPER=replace_with_strong_random_hex
AUTH_OTP_PEPPER=replace_with_strong_random_hex
AUTH_TOTP_SECRET_KEY=replace_with_64_hex_chars
AUTH_TOTP_ISSUER=EIP

# Cookie/session policy
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_CSRF_REQUIRE_ORIGIN=true
AUTH_SESSION_TTL_MIN=720
AUTH_SESSION_IDLE_TTL_MIN=120
AUTH_SESSION_TOUCH_INTERVAL_SEC=300
AUTH_SESSION_BIND_USER_AGENT=true
AUTH_DEVICE_COOKIE_NAME=did
AUTH_DEVICE_COOKIE_DAYS=90

# Step-up / login policy
AUTH_REQUIRE_TOTP_FOR_PRIVILEGED=true
AUTH_OTP_TTL_SEC=600
AUTH_OTP_MAX_ATTEMPTS=6
AUTH_LOGIN_FAILURE_THRESHOLD=8
AUTH_LOGIN_LOCK_MIN=15
LOG_DEV_OTP=false

# Email delivery for OTP/request-access flows
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REQUEST_ACCESS_TO=

# Operational health
# Keep false for public production unless intentionally exposed behind controls.
ENABLE_PUBLIC_DB_HEALTH=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Workbench UI build-time variable
VITE_API_BASE_URL=https://your-api.example.com
