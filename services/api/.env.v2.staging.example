# API runtime (staging)
NODE_ENV=production
HOST=0.0.0.0
PORT=4010
LOG_LEVEL=info
TRUST_PROXY=true

# In single-origin staging via reverse proxy, set this to the public staging origin.
CORS_ORIGIN=https://localhost:8443
CORS_CREDENTIALS=true

# V2 database target (must point to migrated V2 DB)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_me
DB_DATABASE=eip_V2

# Auth shell secrets (required)
AUTH_SESSION_PEPPER=replace_with_strong_random_hex
AUTH_CSRF_PEPPER=replace_with_strong_random_hex

# Cookie/session policy
# Keep true for secure local/staging TLS gateway mode.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_CSRF_REQUIRE_ORIGIN=true
AUTH_SESSION_TTL_MIN=720
AUTH_SESSION_IDLE_TTL_MIN=120
AUTH_SESSION_TOUCH_INTERVAL_SEC=300
AUTH_SESSION_BIND_USER_AGENT=true
AUTH_DEVICE_COOKIE_NAME=did
AUTH_DEVICE_COOKIE_DAYS=90
AUTH_DEVICE_PEPPER=replace_with_strong_random_hex

# Step-up policy
AUTH_OTP_PEPPER=replace_with_strong_random_hex
AUTH_OTP_TTL_SEC=600
AUTH_OTP_MAX_ATTEMPTS=6
AUTH_LOGIN_FAILURE_THRESHOLD=8
AUTH_LOGIN_LOCK_MIN=15
AUTH_TOTP_SECRET_KEY=replace_with_64_hex_chars
AUTH_TOTP_ISSUER=EIP
AUTH_REQUIRE_TOTP_FOR_PRIVILEGED=true
LOG_DEV_OTP=false

# Email delivery (OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_mailbox
SMTP_PASS=replace_with_app_password
SMTP_FROM=replace_with_sender_address

# Health/operational knobs
ENABLE_PUBLIC_DB_HEALTH=true
# Keep this high enough for browser smoke suites (authoring + permission checks).
# Tighten at edge/gateway and production hardening layers later.
RATE_LIMIT_MAX=1000

# Staging smoke seed password (used by seed:staging:smoke)
STAGING_SMOKE_SHARED_PASSWORD=V2Smoke!Pass123
